        </comment>
      </technology>
      <timePeriod startDate="1985-01-01" endDate="2009-12-31" isDataValidForEntirePeriod="true">
        <comment>
          <text xml:lang="en" index="1">Time period: Average lignite spoil composition from literature references. Transfer coefficients from prospective model, specific to lignite spoil.</text>
        </comment>
