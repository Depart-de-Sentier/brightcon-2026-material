        </comment>
      </technology>
      <timePeriod startDate="2014-01-01" endDate="2014-12-31" isDataValidForEntirePeriod="true">
        <comment>
          <text xml:lang="en" index="1">Time period: Amount of material investigated in 2013. Disposal technology mix as used in late 1990ies</text>
