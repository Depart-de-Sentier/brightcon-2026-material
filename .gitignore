# Track raw inputs and folder documentation; ignore other data payloads.
/data/**
!/data/**/
!/data/**/README.md
!/data/raw/**

# Generated artifacts belong in local output folders.
/outputs/
/artifacts/
/reports/generated/

# Credentials and local settings.
.env
.env.*
!.env.example
*.pem
*.key

# Python and notebooks.
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Editors and operating systems.
.DS_Store
.idea/
.vscode/
*.swp
